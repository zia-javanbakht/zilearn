# AI provider: set ONE of these keys (or both, and pick with ZILEARN_PROVIDER).
# The AI does structuring, lessons, mock exams and marking, review notes, flashcards and podcast scripts.
# Without any key ziLearn still works using built-in heuristics.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional: which provider to use when several keys are set (claude, gemini or openai; default: claude)
# ZILEARN_PROVIDER=gemini

# Optional: an OpenAI-compatible server (OpenAI, OpenRouter, Ollama, LM Studio). Used with ZILEARN_PROVIDER=openai.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5-mini

# Everything above can also be set on the Settings page instead; values saved there win.

# Optional: override the models
# ZILEARN_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-flash-latest

# Optional: where the SQLite database and uploaded files are stored (default: ./data)
# ZILEARN_DATA_DIR=./data

# Optional: printing lessons to PDF needs XeLaTeX and the Z LaTeX class. If Z isn't installed in your
# TeX tree, point this at the Z repository's tex/latex folder. XELATEX overrides the xelatex command.
# Z_TEX_DIR=/path/to/Z/tex/latex
# XELATEX=xelatex
