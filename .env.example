# Claude powers structuring, lessons, mock exams, review notes and podcast scripts.
# Without a key ziLearn still works using built-in heuristics.
ANTHROPIC_API_KEY=

# Optional: override the Claude model (default: claude-opus-5-5)
# ZILEARN_MODEL=claude-opus-5-5

# Optional: where the SQLite database and uploaded files are stored (default: ./data)
# ZILEARN_DATA_DIR=./data
